# Neon PostgreSQL Connection String (Pooled connection recommended for serverless)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/pocketflow?sslmode=require"

# Direct URL for migrations if pooling interferes with DDL
DIRECT_DATABASE_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/pocketflow?sslmode=require"

# Authentication Secret (Used by jose / auth session tokens)
AUTH_SECRET="pocketflow-dev-secret-super-secure-change-in-production-min-32-chars-long"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
