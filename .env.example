# ==============================================================================
# POCKETFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real credentials or .env.local to version control.
# - Keep all secrets and database connection strings strictly server-side.
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL) - [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Pooled Connection String:
# Recommended for serverless runtime (Vercel Route Handlers & Server Actions)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/pocketflow_db?sslmode=require"

# Direct Connection String (Optional / For DDL Migrations):
# Recommended for Drizzle Kit schema migrations if transaction pooling interferes with DDL locks.
# Format: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_DATABASE_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/pocketflow_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY - [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT session cookies (HS256).
# Must be at least 32 characters long.
# Generate on Linux/macOS/Git Bash: openssl rand -base64 32
# Generate on PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
AUTH_SECRET="your-ultra-secure-random-secret-key-at-least-32-chars-long"

# Resend API Key for sending Password Reset OTP emails (Optional in dev, recommended in prod)
RESEND_API_KEY=""

# Custom Sender Email (optional)
EMAIL_FROM="PocketFlow <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE (Receipts / Invoices) - [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Free tier provides 25GB of media storage with dynamic transformations.
# Sign up at https://cloudinary.com and obtain credentials from Dashboard.
# If omitted in development, falls back safely to local data URIs for quick testing.
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (Chatbot NLP & Vision Receipt OCR) - [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Free tier provides 15 RPM / 1M tokens per day via Google AI Studio.
# Obtain API Key at: https://aistudio.google.com/app/apikey
# If omitted or invalid, automatically falls back to deterministic rule-based NLP parser.
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 6. PUBLIC APPLICATION URL - [CLIENT & SERVER ACCESSIBLE]
# ------------------------------------------------------------------------------
# Base URL of the deployed application. Safe to expose publicly.
NEXT_PUBLIC_APP_URL="https://your-pocketflow-app.vercel.app"

